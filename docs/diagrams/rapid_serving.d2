...@serving_colors

**: {
  &shape: image
  width: 100
}

user: {
  shape: person
}

user -> bunny.pull_zone: Download packages

bunny: Bunny {
  tooltip: |md
    Rapid repos are served to players from
    https://repos-cdn.beyondallreason.dev/.

    The CDN is provided by https://bunny.net/.
  |

  pull_zone: Pull Zone {
    tooltip: |md
      https://repos-cdn.beyondallreason.dev/

      The repos.gz master list is maintained directly in the storage zone. The
      builder does not write it.
    |

    edge_rule: Edge Rule {
      tooltip: |md
        Redirects a repo's versions.gz to the unique fresh copy uploaded by the
        last build.

        This works around Bunny storage replication lag. Edge rule changes
        propagate globally within a minute, but newly uploaded files do not.
      |
    }
  }

  storage: Storage Zone {
    shape: cylinder
    tooltip: |md
      Holds the pool, packages, versions.gz, and fresh copies for every repo.
      It is the origin for the pull zone.
    |
  }

  pull_zone -> storage: origin
}

rapid: Rapid Hosting Server {
  class: vm
  tooltip: |md
    Debian host managed with the Ansible playbook at
    https://github.com/beyond-all-reason/rapid-hosting.

    The host is shared with the SPADS setup. All services run as Podman
    quadlets.
  |

  caddy: Caddy {
    tooltip: |md
      Terminates TLS for https://repos.beyondallreason.dev/, serves the store as
      the origin for the repos, and reverse-proxies /build to the builder
      without buffering the response.
    |
  }

  builder: rapid-builder {
    tooltip: |md
      HTTP service that builds Rapid packages on request and publishes them to
      Bunny. It verifies the OIDC token, evaluates the repo's CEL policy, and
      serializes builds for each repo.

      Source: https://github.com/beyond-all-reason/rapid-hosting/tree/main/rapid-builder
    |
    link: https://github.com/beyond-all-reason/rapid-hosting/tree/main/rapid-builder
  }

  buildgit: rapid-buildgit {
    tooltip: |md
      Tool that converts a Git checkout to Rapid format and incrementally
      updates the local store.

      Part of https://github.com/beyond-all-reason/RapidTools
    |
  }

  store: Rapid Store {
    shape: page
    style.multiple: true
  }

  git_checkouts: Git Checkouts {
    shape: page
    style.multiple: true
  }

  caddy -> builder: POST /build
  caddy -> store: read

  builder -> git_checkouts: fetch commit
  builder -> buildgit: invoke
  builder -> store: read

  buildgit -> git_checkouts: read
  buildgit -> store: write
}

rapid.builder -> bunny.storage: Upload pool, packages,\nand versions.gz (rclone)
rapid.builder -> bunny.pull_zone.edge_rule: Upload a fresh copy and\nupdate the rule

actions: GitHub Actions {
  class: github
  tooltip: |md
    A workflow in the game repo calls the composite action to request a build
    and stream its log. The action retries transient failures.

    Source: https://github.com/beyond-all-reason/rapid-hosting/tree/main/action
  |
  link: https://github.com/beyond-all-reason/rapid-hosting/tree/main/action
}

oidc: GitHub OIDC Provider {
  class: github
  tooltip: |md
    https://token.actions.githubusercontent.com

    The workflow's token is the only credential. GitHub and the builder do not
    share any secrets.
  |
}

chobby_repo: BYAR-Chobby {
  class: github
  link: https://github.com/beyond-all-reason/BYAR-Chobby
}

bar_repo: Beyond-All-Reason {
  class: github
  link: https://github.com/beyond-all-reason/Beyond-All-Reason
}

*_repo -> actions: Trigger workflow
actions -> oidc: Mint token
actions -> rapid.caddy: POST /build (OIDC token)
rapid.builder -> oidc: Verify token
rapid.builder -> *_repo: Fetch commit
